---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EntryCard from '../../components/EntryCard.astro';
import Icon from '../../components/Icon.astro';
import { publishedEntries, sectionFor, sections, sitePath } from '../../lib/catalog';

export function getStaticPaths() {
  return sections.map((section) => ({ params: { section: section.slug } }));
}

const section = sectionFor(Astro.params.section!)!;
const entries = (await publishedEntries()).filter((entry) =>
  entry.data.section === section.slug && !entry.data.slug.includes('/')
);
---
<BaseLayout title={section.title} description={section.description} section={section.slug} crumbs={[{ title: section.title }]}>
  <div class="catalog-page">
    <header class="catalog-header">
      <span class="eyebrow">Beta · ACERVO {String(section.index).padStart(2, '0')}</span>
      <h1>{section.title}</h1>
      <p class="catalog-subtitle">{section.subtitle}</p>
      <p class="catalog-description">{section.description}</p>
    </header>
    <section class="catalog-body" data-catalog aria-labelledby="catalog-heading">
      <div class="catalog-toolbar">
        <div class="catalog-count"><Icon name="book" size={18}/><span id="catalog-heading"><strong data-visible-count>{entries.length}</strong> {entries.length === 1 ? 'entrada encontrada' : 'entradas encontradas'}</span></div>
        <label class="catalog-filter"><Icon name="search" size={19}/><span class="visually-hidden">Filtrar registros</span><input data-card-filter type="search" placeholder={`Filtrar ${section.title.toLowerCase()}...`} autocomplete="off"/></label>
      </div>
      <div class="entry-grid catalog-grid">
        {entries.map((entry) => <EntryCard entry={entry}/>)}
      </div>
      <p class="no-results" data-filter-empty hidden>Nenhuma entrada corresponde a este termo. Experimente outra busca.</p>
      {entries.length === 0 && <div class="empty-catalog"><Icon name="book" size={38}/><h2>Este acervo aguarda seus primeiros registros.</h2></div>}
    </section>
    <div class="catalog-footnote"><Icon name="info" size={19}/><p>Conteúdo organizado a partir dos arquivos HTML enviados. A revisão editorial das regras continua sob responsabilidade do projeto Avalon.</p></div>
  </div>
</BaseLayout>
